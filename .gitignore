# ---- build directories ----
/build/
/build-*/
/cmake-build-*/
/out/
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json
Makefile

# ---- compiled objects / binaries / libs ----
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.exp

# ---- profile-guided optimization artifacts ----
*.gcda
*.gcno
*.gcov
gmon.out

# ---- python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ---- training data, checkpoints, networks (loaded at runtime, never tracked) ----
/artifacts/
/tools/data/
*.nnue
# ...except the one shipped default net embedded into the ChessEngine-nnue binary.
!nets/*.nnue
*.npz
*.pt
*.ckpt
*.meta.json

# ---- editors / IDEs ----
/.idea/
/.vscode/
*.swp

# ---- OS cruft ----
.DS_Store
Thumbs.db

# ---- logs / temp ----
*.log
*.tmp
*.cache
runs/
*.jsonl.zst

# Visualizer UI: node_modules is never committed, but the built single-file
# bundle IS -- ChessEngine-viz embeds it, so a C++ build needs no Node.
ui/node_modules/
ui/.vite/
ui/dist-wasm/
# Only the single-file bundle is committed (it is what gets embedded); other
# build artefacts in dist/ are copies of files already tracked in ui/public/.
ui/dist/*
!ui/dist/index.html
